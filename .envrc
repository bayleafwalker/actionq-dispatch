# Normal work-state operations use the Vuoro shared authority. The legacy
# compatibility launcher delegates execution to ActionQ and never opens a
# Sprintctl database directly.
export SPRINTCTL_BACKEND=served
export SPRINTCTL_VUORO_PROFILE=/projects/dev/agentops/templates/dispatch/environment-record/profiles/workstation-vuoro-shared.json
unset SPRINTCTL_URL
